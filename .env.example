DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=murandasishop_db

# Run pending DB migrations automatically when Node starts (default: true).
# Set to false only on read-only replicas or if you run migrations manually.
# RUN_MIGRATIONS=true

API_PORT=4000
# Vite dev API target (npm run dev:web). Production uses same-origin /api on your domain.
#
# Hosted API while developing locally (no local Node needed):
VITE_API_URL=https://murandasishop.com/api
#
# Local API instead (also run npm run dev:api or npm run dev):
# VITE_API_URL=http://localhost:4000/api
# Public storefront URL — used by article-meta.php for og:image / og:url (production).
# PUBLIC_SITE_URL=https://murandasishop.com
# Server logs are written to logs/api-YYYY-MM-DD.log (change folder here).
# LOG_DIR=logs
JWT_SECRET=change-me

# Google Sign-In (OAuth client ID is public; keep secret server-side only)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OpenAI — Murandasi AI Shopping
OPENAI_API_KEY=sk-proj-your-key
OPENAI_MODEL=gpt-4o-mini

INTOUCHPAY_MODE=sandbox
INTOUCHPAY_BASE_URL=https://developer.intouchpay.co.rw
INTOUCHPAY_USERNAME=murandasi0009
INTOUCHPAY_ACCOUNT_NO=SBX00000013
# Always quote if password contains # or &
INTOUCHPAY_PARTNER_PASSWORD="your-partner-password"
# Public HTTPS URL only (must be whitelisted by IntouchPay). localhost is blocked (SSRF).
INTOUCHPAY_CALLBACK_URL=https://murandasishop.com/api/payments/intouchpay/callback
# Alias also supported: https://murandasishop.com/webhooks/intouch
# Optional public base URL — callback path is appended automatically.
# INTOUCHPAY_PUBLIC_BASE_URL=https://murandasishop.com
# Local testing: `npm run tunnel` publishes a public URL in .tunnel-url.
# Set to true only to send payments with no callbackurl (polling only).
# INTOUCHPAY_ALLOW_NO_CALLBACK=false
# Live later: INTOUCHPAY_MODE=live and INTOUCHPAY_BASE_URL=https://www.intouchpay.co.rw
